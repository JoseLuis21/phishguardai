# Copia este archivo a .env.local y completa los valores.
# .env.local está en .gitignore: nunca subas credenciales al repositorio.

# --- Base de datos MySQL (obligatorio) ---
# La misma base donde escribe el analizador en Python.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=phishguard
MYSQL_USER=phishguard_web
MYSQL_PASSWORD=

# --- Auth.js (obligatorio) ---
# Firma las sesiones JWT. Genera uno con: openssl rand -base64 32
AUTH_SECRET=

# --- Correo SMTP (obligatorio para /registro) ---
# Envía el enlace de activación de cuenta. El puerto 465 usa TLS directo;
# cualquier otro (p. ej. 587) exige STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Opcional. Por defecto: "PhishGuardAI" <SMTP_USER>
# SMTP_FROM="PhishGuardAI" <no-responder@tudominio.cl>

# --- URL pública (opcional) ---
# Origen de los enlaces que van en los correos. En desarrollo se usa
# http://localhost:3000 y en Vercel el dominio de producción del proyecto.
# APP_URL=https://phishguard.tudominio.cl
